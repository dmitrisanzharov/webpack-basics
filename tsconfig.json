{
    "compilerOptions": {
        "allowJs": false,
        "esModuleInterop": true,
        "module": "ESNext",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "target": "ES6",
        "ignoreDeprecations": "6.0",
        "moduleResolution": "bundler",
        "paths": {
            "@foo": ["./src/foo"]
        }
    },
    "include": ["src"],
    "exclude": ["dist"]
}
