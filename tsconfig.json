{
    "compilerOptions": {
        "target": "ES6",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "outDir": "./dist",
        "strict": true,

        // for React
        "lib": ["dom", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",

        "paths": {
            "@components/*": ["./src/components/*"],
            "@assets/*": ["./src/assets/*"],
            "@mahman/*": ["./src/*"]
        }
    },
    "include": ["src"]
}
