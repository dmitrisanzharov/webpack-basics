{
    "compilerOptions": {
        "esModuleInterop": true,
        "module": "ESNext",
        "moduleResolution": "node",
        "outDir": "./dist",
        "strict": true,
        "target": "ES6",
        "jsx": "react-jsx",
        "paths": {
            "@components/*": ["./src/components/*"],
            "@helpers/*": ["./src/helpers/*"]
        }
    },
    "include": ["src"]
}
