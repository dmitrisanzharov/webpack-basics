{
    "compilerOptions": {
        "allowJs": false,
        "esModuleInterop": true,
        "module": "ESNext",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "target": "ES6",
        "ignoreDeprecations": "6.0",
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "paths": {
            "@myAssets/*": ["src/assets/*"],
            "@core/*": ["src/*"],
            "@foo/*": ["src/"]
        }
    },
    "include": ["src"],
    "exclude": ["dist"]
}
