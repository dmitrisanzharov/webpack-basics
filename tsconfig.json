{
    "compilerOptions": {
        "allowJs": false,
        "esModuleInterop": true,
        "module": "ESNext",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "target": "ES6",
        "ignoreDeprecations": "6.0",
        "moduleResolution": "bundler",
        "paths": {
            "@foo": ["./src/foo"]
        },
        "lib": ["dom", "esnext"],
        "skipLibCheck": true,
        "jsx": "react-jsx"
    },
    "include": ["src"],
    "exclude": ["dist"]
}
